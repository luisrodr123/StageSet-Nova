{
  "name": "stage-set",
  "version": "0.10.0",
  "description": "Windows setlist, lyrics and karaoke player",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "node server.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:win:portable": "electron-builder --win portable --publish never",
    "dist:win:all": "electron-builder --win nsis portable --x64 --publish never",
    "dist:win:zip": "electron-builder --win zip --publish never",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:smoke": "electron tests/smoke.cjs",
    "bump": "node scripts/version.mjs"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "pt.stageset.desktop",
    "productName": "StageSet",
    "npmRebuild": false,
    "electronLanguages": [
      "en-US",
      "pt-PT"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signExecutable": false,
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "StageSet-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "StageSet-${version}-Portable-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "StageSet-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "*.svg",
      "*.webmanifest",
      "server.mjs",
      "desktop/**",
      "package.json",
      "STAGESET-ALTERACOES.md",
      "README.md"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
